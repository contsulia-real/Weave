      "prompt": "Create a multiline profile note editor.",
      "requiredComponents": ["Input"],
      "forbiddenComponents": ["View"]
    },
    {
      "id": "primary-action",
      "prompt": "Create a primary Save action.",
      "requiredComponents": ["Button"],
      "forbiddenComponents": ["Link", "View"]
    },
    {
      "id": "navigation-link",
      "prompt": "Create navigation to the account settings page.",
      "requiredComponents": ["Link"],
      "forbiddenComponents": ["Button", "View"]
    },
    {
      "id": "vertical-settings",
      "prompt": "Arrange several settings controls in a vertical sequence.",
      "requiredComponents": ["Column"],
      "forbiddenComponents": ["View"]
    },
    {
      "id": "horizontal-actions",
      "prompt": "Arrange Cancel and Save actions horizontally.",
      "requiredComponents": ["Row"],
      "forbiddenComponents": ["View"]
    },
    {
