      "requiredComponents": ["Switch"],
      "forbiddenComponents": ["View"]
    },
    {
      "id": "check-consent",
      "prompt": "Create a consent checkbox in a form.",
      "requiredComponents": ["Checkbox"],
      "forbiddenComponents": ["View"]
    },
    {
      "id": "toast-feedback",
      "prompt": "Show transient application feedback using Weave's snack system.",
      "anyOfComponents": ["Snack", "SnackProvider"],
      "forbiddenComponents": ["View"]
    },
    {
      "id": "responsive-layout",
      "prompt": "Create a responsive content layout using formal Weave layout components rather than the low-level primitive.",
      "anyOfComponents": ["Column", "Row", "Flex", "Grid"],
      "forbiddenComponents": ["View"]
    },
    {
      "id": "themed-app",
      "prompt": "Wrap an application in Weave's theme provider.",
      "requiredComponents": ["ThemeProvider"],
      "forbiddenComponents": ["View"]
    },
    {
      "id": "avatar-list",
      "prompt": "Create a list of users with avatars and list items.",
